[Unit]
Description=BD follow-up draft pack (up to 5 ready-to-send drafts for Dave-owed BD next actions)
After=network-online.target qmd-mcp.service bd-stall-radar.service
Wants=network-online.target
ConditionPathExists=/home/dave/agent-worktrees/inbox
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
Environment=AGENT_JOB_OVERRIDES=/home/dave/.config/agent-workforce/bd_followup_drafts.env
# Deliver THIS job's pack, not the overnight report's (deliver_report.sh defaults to
# ~/logs/overnight/morning-report-*.md).
Environment=REPORT_DIR=/home/dave/agent-worktrees/inbox/_inbox/agents
Environment=REPORT_GLOB=*_bd-followup-drafts.md
Environment="REPORT_SUBJECT=[Praetorium] BD follow-up drafts"
Environment=DELIVERY_ROUTE=bd
Environment=DELIVERY_JOB=%n
# The pack lands in the shared inbox directory alongside every other proposal, so
# "newest match" is not enough on a night this job produces nothing — the marker
# makes the glob's newest hit prove it belongs to this run. See
# overnight-morning-report.service.
Environment=DELIVERY_RUN_MARKER=/home/dave/logs/run-markers/%n
ExecStartPre=/usr/bin/mkdir -p /home/dave/logs/run-markers
ExecStartPre=/usr/bin/touch /home/dave/logs/run-markers/%n
EnvironmentFile=/home/dave/.config/agent-workforce/secrets.env
ExecStart=/home/dave/agent-workforce/bin/agent_propose.sh
ExecStartPost=/home/dave/agent-workforce/bin/deliver_report.sh
TimeoutStartSec=45min
NoNewPrivileges=true
