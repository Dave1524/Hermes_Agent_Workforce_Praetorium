# One research run for one approved card (board reactor, D1). Started only by
# bin/board_reactor.py with `systemctl start --no-block board-work@<card>.service`; never enabled,
# never timed. The standing research runner in card mode: the model works in the card's run
# directory and the wrapper publishes research.md as the card's Notion page. The run takes
# /tmp/agent_board_card_<id>.lock, not the fleet lock (AGENT_BOARD_CARD), and never checks out
# the inbox; ReadOnlyPaths= is the guarantee that it writes no vault tree.
[Unit]
Description=Board research run for card %i (headless Claude Code) — board reactor
After=network-online.target qmd-mcp.service brave-mcp.service
Wants=network-online.target brave-mcp.service
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
Environment=AGENT_JOB_OVERRIDES=/home/dave/.config/agent-workforce/board_work.env
Environment=AGENT_BOARD_CARD=%i
Environment=AGENT_RECEIPT_UNIT=board-work
Environment=AGENT_ATTEMPT_LOG=/home/dave/agent-workforce/logs/last-attempt/board-work-%i.log
Environment=AGENT_USAGE_JSON=/home/dave/agent-workforce/logs/last-attempt/board-work-%i.usage.json
Environment="REPORT_SUBJECT=[Praetorium] Board research"
Environment=DELIVERY_ROUTE=research
Environment=DELIVERY_JOB=%n
Environment=DELIVERY_TASK=board-work
Environment=DELIVERY_CARD=%i
Environment=DELIVERY_RUN_MARKER=/home/dave/logs/run-markers/%n
EnvironmentFile=/home/dave/.config/agent-workforce/secrets.env
EnvironmentFile=-/home/dave/.config/agent-workforce/board_reactor.env
ExecCondition=/home/dave/agent-workforce/bin/board.py exists %i
ExecStartPre=/usr/bin/mkdir -p /home/dave/logs/run-markers
ExecStartPre=/usr/bin/touch /home/dave/logs/run-markers/%n
ExecStart=/home/dave/agent-workforce/bin/agent_propose.sh
ExecStartPost=/home/dave/agent-workforce/bin/deliver_proposal.sh
ReadOnlyPaths=/home/dave/agent-worktrees /home/dave/dev/Obsidian_AI_Operating_System /home/dave/dev/obsidian-ai-os-boxsafe
TimeoutStartSec=50min
NoNewPrivileges=true
