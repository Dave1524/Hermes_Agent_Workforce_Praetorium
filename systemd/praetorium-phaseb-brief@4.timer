# One-shot: fires once at the dated slot below, then is spent. Not recurring — a daily
# OnCalendar would rewrite the brief every night. Clear slot.
[Unit]
Description=Phase-B brief 4 — one-shot at 2026-09-02 02:07:00

[Timer]
OnCalendar=2026-09-02 02:07:00
AccuracySec=1min
Persistent=true
Unit=praetorium-phaseb-brief@4.service

[Install]
WantedBy=timers.target
