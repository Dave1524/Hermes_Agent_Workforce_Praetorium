# Brave Search MCP HTTP daemon — NUC-21 (claudius web search).
# Mirrors qmd-mcp.service: a persistent warm HTTP MCP the consumers reach via
# `url: http://127.0.0.1:8766/mcp`, replacing the per-run npx stdio cold-spawn
# that lost the oneshot background-discovery race (see docs/data_boundary.md).
# The launcher lives in this repo since T6.1 (2026-09-16); it was under ~/.hermes/bin before.
# Deploy: sudo cp to /etc/systemd/system/, then `sudo systemctl daemon-reload
# && sudo systemctl enable --now brave-mcp.service`. Key comes from brave-mcp.env.
[Unit]
Description=Brave Search MCP HTTP daemon (claudius web search) — NUC-21
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dave
EnvironmentFile=/home/dave/.config/agent-workforce/brave-mcp.env
ExecStart=/home/dave/agent-workforce/bin/brave_mcp_launch.sh --transport http --port 8766 --host 127.0.0.1
Restart=on-failure
RestartSec=10
# Localhost-only bind; the box itself is Tailscale-only (no public ports).
NoNewPrivileges=true
ProtectSystem=full
# Sandbox (2026-09-19, from claudius's research, corrected): every line here changes no
# behaviour for a node HTTP daemon running as dave. Deliberately absent — ProtectHome: it
# serves and reads under /home/dave; MemoryDenyWriteExecute: node's JIT; IPAddressAllow/
# Deny: the bind is already loopback and outbound stays open (brave: api.search.brave.com;
# qmd: model fetches). Measure with `systemd-analyze security <unit>` before changing it.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
PrivateDevices=true

[Install]
WantedBy=multi-user.target
