# One-shot: fires once at the dated slot below, then is spent. Not recurring — a daily
# OnCalendar would rewrite the brief every night. Only 8 min ahead of raw-ingest 03:00 — may overlap under a slow run.
[Unit]
Description=Phase-B brief 5 — one-shot at 2026-09-02 02:52:00

[Timer]
OnCalendar=2026-09-02 02:52:00
AccuracySec=1min
Persistent=true
Unit=praetorium-phaseb-brief@5.service

[Install]
WantedBy=timers.target
