# One-shot: fires once at the dated slot below, then is spent. Not recurring — a daily
# OnCalendar would rewrite the brief every night. After agent-proposal 04:30.
[Unit]
Description=Phase-B brief 6 — one-shot at 2026-09-02 05:22:00

[Timer]
OnCalendar=2026-09-02 05:22:00
AccuracySec=1min
Persistent=true
Unit=praetorium-phaseb-brief@6.service

[Install]
WantedBy=timers.target
