# Deterministic git auto-sync of the agent-workforce SOURCE repo — NUC-25.
# Replaces hermes cron job 59e63d34cf2d (agent-workforce-auto-sync), which paid
# for an LLM turn (z-ai/glm-5.2, OpenRouter) every 15 min purely to shell out to
# this deterministic script. Runs the script directly — no model, no per-tick cost.
#
# NOTE ON PATH: ExecStart intentionally points at the SOURCE checkout, not the
# deployed /home/dave/agent-workforce copy the other units use. bin/auto-sync does
# `cd "$(dirname "$0")/.."` and then git pull/commit/push on that tree; only the
# source checkout (/home/dave/dev/agent-workforce) is a git repo — the deployed
# copy is not — so this unit must invoke the source path (same path the retired
# cron prompt used).
#
# WHY IT ALERTS (OnFailure -> Discord, then retries every ~15 min): bin/auto-sync
# does a `git pull --ff-only origin main`, so this unit fails whenever local `main`
# has DIVERGED from origin/main. Cause is always commits made directly on local
# main and left unpushed while origin advanced (e.g. a merged PR) — auto-sync
# refuses to auto-merge/rebase by design. It only handles small updates it commits
# and pushes itself; significant work belongs on a branch/worktree, never lingering
# unpushed on main. Fix: in /home/dave/dev/agent-workforce run
# `git rebase origin/main && git push origin main`. First hit 2026-07-23.
#
# Deploy: sudo cp both unit files + agent-alert@.service to /etc/systemd/system/,
#         then `sudo systemctl daemon-reload && sudo systemctl enable --now
#         agent-workforce-auto-sync.timer`.
[Unit]
Description=Deterministic git auto-sync of agent-workforce source repo — NUC-25
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/dave/dev/agent-workforce/.git
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
WorkingDirectory=/home/dave/dev/agent-workforce
ExecStart=/home/dave/dev/agent-workforce/bin/auto-sync
TimeoutStartSec=5min
NoNewPrivileges=true
