# Weekly agent-run scorecard rollup -> box-safe digest — NUC-23.
# Runs bin/scorecard.sh (fail-soft, idempotent; pushes an aggregate digest to
# the boxsafe agents/inbox via the github-boxsafe deploy key). No secrets read.
# Deploy: sudo cp to /etc/systemd/system/, then `sudo systemctl daemon-reload
# && sudo systemctl enable --now scorecard.timer`.
[Unit]
Description=Weekly agent-run scorecard rollup — NUC-23
After=network-online.target qmd-mcp.service
Wants=network-online.target
ConditionPathExists=/home/dave/agent-worktrees/inbox/.git

[Service]
Type=oneshot
User=dave
Environment="REPORT_SUBJECT=[Praetorium] Weekly scorecard"
Environment=DELIVERY_ROUTE=ops
Environment=DELIVERY_JOB=%n
Environment=DELIVERY_RUNTIME=none
ExecStart=/home/dave/agent-workforce/bin/scorecard.sh
# No DELIVERY_RUN_MARKER: the digest is idempotent and is NOT rewritten on a week
# with nothing new, so a newer-than-marker test would silence the rollup exactly
# when it is most worth reading. deliver_scorecard.sh composes from current state.
ExecStartPost=/home/dave/agent-workforce/bin/deliver_scorecard.sh
TimeoutStartSec=10min
NoNewPrivileges=true
