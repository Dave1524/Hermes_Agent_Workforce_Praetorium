# Weekly agent-run scorecard rollup -> box-safe digest — NUC-23.
# Runs bin/scorecard.sh (fail-soft, idempotent; pushes an aggregate digest to
# the boxsafe agents/inbox via the github-boxsafe deploy key). No secrets read.
# Deploy: sudo cp to /etc/systemd/system/, then `sudo systemctl daemon-reload
# && sudo systemctl enable --now scorecard.timer`.
[Unit]
Description=Weekly agent-run scorecard rollup — NUC-23
After=network-online.target qmd-mcp.service
Wants=network-online.target
ConditionPathExists=/home/dave/agent-worktrees/inbox/.git

[Service]
Type=oneshot
User=dave
ExecStart=/home/dave/agent-workforce/bin/scorecard.sh
TimeoutStartSec=10min
NoNewPrivileges=true
