# Nightly working-memory consolidation/prune, all agent profiles — NUC-21.
# Runs bin/consolidate_memory.sh (mechanical, no LLM, no network, fail-soft),
# which loops over every */memories dir under ~/.hermes/profiles — a new
# profile is picked up automatically, no unit change needed.
# Deploy: sudo cp to /etc/systemd/system/, then `sudo systemctl daemon-reload`.
[Unit]
Description=Nightly working-memory consolidation/prune, all profiles — NUC-21
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/home/dave/.hermes/profiles
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
ExecStart=/home/dave/agent-workforce/bin/consolidate_memory.sh
TimeoutStartSec=5min
NoNewPrivileges=true
