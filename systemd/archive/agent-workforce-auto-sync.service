# Deterministic git auto-sync of the agent-workforce SOURCE repo — NUC-25.
# Replaces hermes cron job 59e63d34cf2d (agent-workforce-auto-sync), which paid
# for an LLM turn (z-ai/glm-5.2, OpenRouter) every 15 min purely to shell out to
# this deterministic script. Runs the script directly — no model, no per-tick cost.
#
# NOTE ON PATH: ExecStart intentionally points at the SOURCE checkout, not the
# deployed /home/dave/agent-workforce copy the other units use. bin/auto-sync does
# `cd "$(dirname "$0")/.."` and then git pull/commit/push on that tree; only the
# source checkout (/home/dave/dev/agent-workforce) is a git repo — the deployed
# copy is not — so this unit must invoke the source path (same path the retired
# cron prompt used).
#
# WHY IT ALERTS (OnFailure -> agent-alert@ -> Buzz ops; bin/agent_alert.sh sends one
# notification per failure episode plus a 24h reminder, and the timer retries every
# ~15 min). bin/auto-sync exits 1 on three repo states, each one a human resolves:
#
# 1. The checkout has been OFF MAIN longer than the grace window
#    (AUTO_SYNC_OFF_MAIN_GRACE_HOURS, default 4; 0 alerts at once), or git cannot say
#    since when (no usable `checkout: moving from main` entry in the HEAD reflog).
#    Inside the window the run syncs nothing, logs one line naming the branch and the
#    time off main, and exits 0 — no alert. The refusal is what keeps `git add -A`
#    off branch work; the window is what stops a session at work from paging Dave.
#    Fix: finish or park the branch and `git checkout main` here. Better, do branch
#    work in a worktree, which never moves this checkout. To change the window, set
#    Environment=AUTO_SYNC_OFF_MAIN_GRACE_HOURS=<n> in a drop-in.
# 2. Local main has DIVERGED from origin/main, so `git pull --ff-only origin main`
#    fails. Cause is always commits made directly on local main and left unpushed
#    while origin advanced (e.g. a merged PR) — auto-sync refuses to auto-merge/rebase
#    by design. Fix: in /home/dave/dev/agent-workforce run
#    `git rebase origin/main && git push origin main`. First hit 2026-07-23. (An
#    unreachable origin fails the same pull; the next tick retries.)
# 3. `git add -A` staged a nested repository (a worktree or stray clone under this
#    tree) as a gitlink. Fix: add the path to .gitignore or .git/info/exclude.
#
# Deploy: sudo cp both unit files + agent-alert@.service to /etc/systemd/system/,
#         then `sudo systemctl daemon-reload && sudo systemctl enable --now
#         agent-workforce-auto-sync.timer`.
[Unit]
Description=Deterministic git auto-sync of agent-workforce source repo — NUC-25
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/dave/dev/agent-workforce/.git
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
WorkingDirectory=/home/dave/dev/agent-workforce
ExecStart=/home/dave/dev/agent-workforce/bin/auto-sync
TimeoutStartSec=5min
NoNewPrivileges=true
