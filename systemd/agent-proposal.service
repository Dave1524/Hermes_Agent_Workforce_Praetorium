[Unit]
Description=Scheduled standing research run (headless Claude Code, Opus 5) — NUC-16
After=network-online.target qmd-mcp.service brave-mcp.service
Wants=network-online.target brave-mcp.service
ConditionPathExists=/home/dave/agent-worktrees/inbox
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
Environment=AGENT_JOB_OVERRIDES=/home/dave/.config/agent-workforce/standing_research.env
EnvironmentFile=/home/dave/.config/agent-workforce/secrets.env
ExecStart=/home/dave/agent-workforce/bin/agent_propose.sh
ExecStartPost=/home/dave/agent-workforce/bin/notify.sh "[Praetorium] Agent proposal completed" "Agent proposal service completed. Check inbox for results."
TimeoutStartSec=45min
NoNewPrivileges=true
