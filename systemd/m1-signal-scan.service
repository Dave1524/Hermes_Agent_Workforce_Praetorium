[Unit]
Description=M1 market signal scan — NUC-32
After=network-online.target qmd-mcp.service brave-mcp.service
Wants=network-online.target brave-mcp.service
OnFailure=agent-alert@%n.service
ConditionPathExists=/home/dave/agent-worktrees/inbox

[Service]
Type=oneshot
User=dave
Environment=AGENT_JOB_OVERRIDES=/home/dave/.config/agent-workforce/m1_signal_scan.env
Environment="REPORT_SUBJECT=[Praetorium] M1 signal scan"
Environment=DELIVERY_ROUTE=signals
Environment=DELIVERY_JOB=%n
Environment=DELIVERY_TASK=m1-signal-scan
Environment=DELIVERY_RUN_MARKER=/home/dave/logs/run-markers/%n
EnvironmentFile=/home/dave/.config/agent-workforce/secrets.env
ExecStartPre=/usr/bin/mkdir -p /home/dave/logs/run-markers
ExecStartPre=/usr/bin/touch /home/dave/logs/run-markers/%n
ExecStart=/home/dave/agent-workforce/bin/agent_propose.sh
ExecStartPost=/home/dave/agent-workforce/bin/deliver_proposal.sh
TimeoutStartSec=45min
NoNewPrivileges=true
