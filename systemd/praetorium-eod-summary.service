# EOD summary via the guarded runner (AGENT_RUN_MODE=ops) — NUC-45.
# Replaces the Mac's scheduled daily-eod-wrap. The interactive eod-wrap stays canonical
# and overwrites this row in place (same date-keyed title) when Dave runs it later.
[Unit]
Description=Praetorium EOD summary (ops mode) — NUC-45
After=network-online.target qmd-refresh.service
Wants=network-online.target
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
Environment=AGENT_JOB_OVERRIDES=/home/dave/.config/agent-workforce/eod_summary.env
Environment=REPORT_DIR=/home/dave/logs/eod-summary
Environment=REPORT_GLOB=eod-summary-*.md
Environment=REPORT_SUBJECT=[Praetorium] EOD summary
EnvironmentFile=/home/dave/.config/agent-workforce/secrets.env
ExecStart=/home/dave/agent-workforce/bin/agent_propose.sh
ExecStartPost=/home/dave/agent-workforce/bin/deliver_report.sh
TimeoutStartSec=20min
NoNewPrivileges=true
