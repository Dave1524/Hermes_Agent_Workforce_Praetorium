# inbox-backlog-alert.service — NUC-30.
# Model-free (no LLM, no OpenRouter spend): checks the agent-inbox approval
# backlog and, if the oldest pending proposal is > 2 days old, posts a single
# line via bin/deliver.sh. Silent when the inbox is clear or under threshold.
# Shape copied from content-change-dispatch.service (plain bin runner + OnFailure
# alert), minus the AGENT_JOB_OVERRIDES / secrets env — delivery reuses the
# ~/.hermes credentials and the Buzz credential helper, and needs no OpenRouter key.
[Unit]
Description=Agent-inbox approvals-aging alert (>2d oldest pending) — NUC-30
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/dave/agent-worktrees/inbox
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
Environment=DELIVERY_ROUTE=approvals
Environment=DELIVERY_JOB=%n
ExecStart=/home/dave/agent-workforce/bin/inbox_backlog_alert.sh
TimeoutStartSec=5min
NoNewPrivileges=true
