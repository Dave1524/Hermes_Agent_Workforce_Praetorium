# Generic OnFailure alert handler (template) — NUC-25 / NUC-30.
# Convention: units add `OnFailure=agent-alert@%n.service` and systemd starts one
# instance per failing unit, with %i = the failed unit's name.
#
# Delivers to THREE places — local journal, local log file, and notify.sh:
#   1. Journal (tag "agent-alert", priority err) — secret-free, always works.
#   2. Log file at /home/dave/logs/agent-alert.log.
#   3. notify.sh (NUC-30) — fail-soft; since 2026-08-04 it hands off to
#      bin/deliver.sh, which posts to Discord AND the Buzz ops channel.
#
# The local journal and log paths are deliberately first and independent: they are
# the only two that still work when the failure being reported IS the transport.
#
# The behaviour now lives in bin/agent_alert.sh rather than inline here, because a
# handler quoted twice inside a unit file cannot be tested and this one now has to
# decide something: paths 1 and 2 fire on EVERY failure, path 3 only on the
# transition INTO failure. Repetition is not news — on 2026-08-14 a stuck
# qmd-refresh emitted 14 identical alerts, and across the 17-31 Aug fortnight one
# such unit would bury every other unit's first failure. See that script's header.
#
# Deploy: sudo cp to /etc/systemd/system/ + daemon-reload. No enable needed — it
# is pulled in on demand by OnFailure=. (% is escaped as %% in unit files; %i is
# the systemd instance specifier.)
[Unit]
Description=OnFailure alert for %i — NUC-25 / NUC-30

[Service]
Type=oneshot
User=dave
# Every failure is operational news regardless of which job failed, so this template
# is the one caller with a fixed route. %i (the failed unit) is carried in the
# subject, not the route.
Environment=DELIVERY_ROUTE=ops
Environment=DELIVERY_JOB=%n
Environment=DELIVERY_RUNTIME=none
EnvironmentFile=/home/dave/.config/agent-workforce/secrets.env
ExecStart=/home/dave/agent-workforce/bin/agent_alert.sh %i
NoNewPrivileges=true
