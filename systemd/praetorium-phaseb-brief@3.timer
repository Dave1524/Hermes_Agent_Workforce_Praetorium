# One-shot: fires once at the dated slot below, then is spent. Not recurring — a daily
# OnCalendar would rewrite the brief every night. 23 min ahead of faceless-content 01:30.
[Unit]
Description=Phase-B brief 3 — one-shot at 2026-09-02 01:07:00

[Timer]
OnCalendar=2026-09-02 01:07:00
AccuracySec=1min
Persistent=true
Unit=praetorium-phaseb-brief@3.service

[Install]
WantedBy=timers.target
