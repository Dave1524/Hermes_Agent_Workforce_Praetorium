# agent-inbox-sync.service — deterministic Notion<->agent-inbox reconcile (no LLM).
# Replaces the glm-5.2 hermes cron `agent-inbox-sync` (98e6eb41f553). Runs the model-free
# pipeline: box->Notion sync + Notion->box apply (auto-reject within the membrane; approves
# surface for the Mac). Budget-independent — does not touch OpenRouter.
# NOTE ON PATH: ExecStart points at the SOURCE checkout (the deployed /home/dave/agent-workforce
# copy is not a git repo, and the apply step git-operates on the agents/inbox worktree).
[Unit]
Description=Deterministic Notion<->agent-inbox reconcile — NUC follow-up (replaces glm-5.2 agent-inbox-sync cron)
After=network-online.target
Wants=network-online.target
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
WorkingDirectory=/home/dave/dev/agent-workforce
Environment="REPORT_SUBJECT=[Praetorium] Agent inbox reconcile"
Environment=DELIVERY_ROUTE=approvals
Environment=DELIVERY_JOB=%n
Environment=DELIVERY_RUNTIME=none
Environment=DELIVERY_RUN_MARKER=/home/dave/logs/run-markers/%n
ExecStartPre=/usr/bin/mkdir -p /home/dave/logs/run-markers
ExecStartPre=/usr/bin/touch /home/dave/logs/run-markers/%n
ExecStart=/home/dave/dev/agent-workforce/bin/agent_inbox_pipeline.sh
# ExecStopPost, not ExecStartPost: a reconcile that FAILED is the outcome most worth
# reporting, and systemd skips ExecStartPost when ExecStart fails.
ExecStopPost=/home/dave/agent-workforce/bin/deliver_inbox_sync.sh
TimeoutStartSec=5min
NoNewPrivileges=true
