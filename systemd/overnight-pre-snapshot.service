# Model-free overnight pre-snapshot — NUC-36.
# Replaces the Hermes cron LLM checklist (profiles/cron-overnight-pre-snapshot.prompt.md).
[Unit]
Description=Overnight pre-snapshot (model-free) — NUC-36
After=network-online.target
Wants=network-online.target
OnFailure=agent-alert@%n.service

[Service]
Type=oneshot
User=dave
Environment=REPORT_DIR=/home/dave/logs/overnight
Environment=REPORT_GLOB=pre-snapshot-*.log
Environment="REPORT_SUBJECT=[Praetorium] Overnight pre-snapshot"
Environment=DELIVERY_ROUTE=ops
Environment=DELIVERY_JOB=%n
# The snapshot shares ~/logs/overnight with the morning report, and its own name is
# stamped per run — so "newest pre-snapshot-*.log" is only this run's on a night the
# snapshot actually wrote one. Anchor it. See overnight-morning-report.service.
Environment=DELIVERY_RUN_MARKER=/home/dave/logs/run-markers/%n
ExecStartPre=/usr/bin/mkdir -p /home/dave/logs/run-markers
ExecStartPre=/usr/bin/touch /home/dave/logs/run-markers/%n
ExecStart=/home/dave/agent-workforce/bin/overnight_pre_snapshot.sh
ExecStartPost=/home/dave/agent-workforce/bin/deliver_report.sh
TimeoutStartSec=5min
NoNewPrivileges=true
