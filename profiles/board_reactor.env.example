# Optional overrides for board-reactor, board-reconcile, board-brief@ and board-work@
# (EnvironmentFile=-, so the file may be absent). All four read it, so they share one BOARD_ROOT.
#
# EXAMPLE ONLY. The live file lives OUTSIDE git at
#   ~/.config/agent-workforce/board_reactor.env  (mode 600, owned by dave)
#
# The defaults below are bin/board_reactor.py's own; set a line only to change it, then
# `sudo systemctl restart board-reactor`. Runbook § Board reactor.
# Runs at once across both templates (board-brief@, board-work@).
BOARD_REACTOR_MAX_RUNS=2
# Starts per box-local day; past it the reactor holds every start until midnight and receipts
# health=capped.
BOARD_REACTOR_DAILY_CAP=24
# Seconds between two starts of one card.
BOARD_REACTOR_COOLDOWN=600
# The board's state directory; defaults to /var/lib/control-room-board.
# BOARD_ROOT=/var/lib/control-room-board
