# NUC-45: per-job override for agent_propose.sh (AGENT_JOB_OVERRIDES) — evening job.
# Non-secret task wiring only; API keys stay in the canonical secrets.env, sourced first.
#
# EXAMPLE ONLY. The live file lives OUTSIDE git at
#   ~/.config/agent-workforce/eod_summary.env  (mode 600, owned by dave)
# and is intentionally NOT committed. Install: copy the vars below, then chmod 600.
AGENT_PROFILE=claude-sonnet
AGENT_TASK_SLUG=eod-summary
AGENT_RUN_MODE=ops
AGENT_MAX_ATTEMPTS=2
AGENT_TIMEOUT_MINUTES=15
AGENT_RUNTIME_CMD='~/agent-workforce/bin/run_eod_summary_cc.sh'
# Same contract as the morning job: the receipt is written only after Notion accepts the
# upsert, and -newermt "@$AGENT_RUN_STARTED_AT" keeps yesterday's receipt from passing.
AGENT_VERIFY_CMD='find "$HOME/logs/eod-summary" -name "receipt-*.json" -newermt "@$AGENT_RUN_STARTED_AT" | grep -q .'
