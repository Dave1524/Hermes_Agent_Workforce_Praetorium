# Per-job override for agent_propose.sh (AGENT_JOB_OVERRIDES) — the Augustus content run,
# read by BOTH augustus-content.service (nightly backstop) and content-change-dispatch.service
# (the picked-row trigger). Non-secret task wiring only; API keys stay in secrets.env.
#
# EXAMPLE ONLY. The live file lives OUTSIDE git at
#   ~/.config/agent-workforce/augustus-content.env  (mode 600, owned by dave)
# Wiring as documented in docs/runbook.md (NUC-46); cost.log has recorded this task as
# outcome=OPS since the Buzz cutover.
AGENT_OWNER=augustus
AGENT_TASK_SLUG=augustus-content
AGENT_RUN_MODE=ops
AGENT_RUNTIME_CMD='~/agent-workforce/bin/run_content_via_buzz.sh'
AGENT_VERIFY_CMD='~/agent-workforce/bin/content_moved.sh'
# Time budget — bin/propose_budget.py; tests/test_propose_budget.sh pins it under both units'
# TimeoutStartSec. One attempt, never more: a retried trigger can draft the same row twice
# (runbook § NUC-46). Per attempt: run_content_via_buzz.sh's own 20-minute wait
# (AGENT_BUZZ_WAIT_MINUTES) plus 5 minutes for dispatch and verify; the longest measured
# success since the turn-end fix (T7.2) is 363s.
AGENT_MAX_ATTEMPTS=1
AGENT_TIMEOUT_MINUTES=25
AGENT_RETRY_BASE_SECONDS=30
AGENT_RETRY_WITHIN_SECONDS=300
