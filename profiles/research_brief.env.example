# Per-job override for agent_propose.sh (AGENT_JOB_OVERRIDES) — the board's brief run (Dev Plan
# B2). Non-secret task wiring only: API keys stay in the canonical secrets.env, sourced first.
#
# EXAMPLE ONLY. The live file lives OUTSIDE git at
#   ~/.config/agent-workforce/research_brief.env  (mode 600, owned by dave)
# Install: copy the vars below into that path, then chmod 600.
#
# AGENT_RUN_MODE=board: lock and pre-flight as `ops` (no inbox checkout, no write boundary, no
# commit), the pick required, and the run's one output — $AGENT_CARD_DIR/brief.out.md — recorded
# by the wrapper as the card's `brief` event. A tick with no Backlog card is a receipted skip
# before any model starts.
AGENT_PROFILE=claude-opus
AGENT_OWNER=claudius
AGENT_TASK_SLUG=research-brief
AGENT_RUN_MODE=board
AGENT_BOARD_PICK="--owner claudius --kind research --column backlog"
AGENT_BOARD_REQUIRED=1
# This runner reaches no MCP daemon (strict, empty server list), so skip the daemon probes.
AGENT_MCP_DEPS=none
# A short run: a card, a few queries, one file. bin/propose_budget.py pins the sum under the
# unit's TimeoutStartSec (20min) — tests/test_propose_budget.sh.
AGENT_MAX_ATTEMPTS=2
AGENT_TIMEOUT_MINUTES=8
AGENT_RETRY_BASE_SECONDS=30
AGENT_RETRY_WITHIN_SECONDS=300
AGENT_RUNTIME_CMD='~/agent-workforce/bin/run_research_brief_cc.sh'
AGENT_VERIFY_CMD='~/agent-workforce/bin/brief_or_decline.sh'
