# Per-job override for agent_propose.sh (AGENT_JOB_OVERRIDES) — one approved research card, run as
# board-work@<card>.service by the board reactor (2026-10-13). Non-secret task wiring only: API
# keys stay in the canonical secrets.env, sourced first.
#
# EXAMPLE ONLY. The live file lives OUTSIDE git at
#   ~/.config/agent-workforce/board_work.env  (mode 600, owned by dave)
# Install: copy the vars below into that path, then chmod 600.
#
# Standing research on one card: the unit sets AGENT_BOARD_CARD=%i, the pick takes that card from
# Todo, and the lock is per card, so two cards run side by side. The inbox checkout still takes
# AGENT_INBOX_LOCK. A card that is no longer in Todo is a receipted skip before any model.
AGENT_PROFILE=claude-opus
AGENT_OWNER=claudius
AGENT_TASK_SLUG=board-work
AGENT_BOARD_PICK="--owner claudius --kind research --column todo"
AGENT_BOARD_REQUIRED=1
# The standing-research budget: bin/propose_budget.py pins the sum under board-work@'s
# TimeoutStartSec (50min) — tests/test_propose_budget.sh.
AGENT_MAX_ATTEMPTS=2
AGENT_TIMEOUT_MINUTES=40
AGENT_RETRY_BASE_SECONDS=30
AGENT_RETRY_WITHIN_SECONDS=300
AGENT_RUNTIME_CMD='~/agent-workforce/bin/run_standing_research_cc.sh'
AGENT_VERIFY_CMD='~/agent-workforce/bin/proposal_or_decline.sh board-work'
