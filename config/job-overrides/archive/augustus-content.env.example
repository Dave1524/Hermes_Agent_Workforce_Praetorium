# Augustus nightly content pitch+draft job. Non-secret task wiring only — API keys stay in
# the canonical secrets.env (sourced first). Sourced by agent_propose.sh via
# AGENT_JOB_OVERRIDES, so it overrides task wiring only, never credentials.
AGENT_PROFILE=augustus
AGENT_TASK_SLUG=augustus-content
AGENT_RUNTIME_CMD='cd ~/agent-worktrees/inbox && ~/agent-workforce/bin/kanban_run_and_wait.sh "Nightly content pitch+draft" ~/agent-workforce/profiles/augustus_content_task.md augustus ~/agent-worktrees/inbox "nightly-augustus-content-$(date -u +%Y-%m-%d)" 20m'
