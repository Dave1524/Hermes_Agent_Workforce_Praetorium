# NUC-24: per-job override for agent_propose.sh (AGENT_JOB_OVERRIDES). Non-secret
# task wiring only — API keys stay in the canonical secrets.env, sourced first.
AGENT_TASK_SLUG=weekly-pre-assembly
AGENT_RUNTIME_CMD='cd ~/agent-worktrees/inbox && ~/.local/bin/hermes -z "$(cat ~/agent-workforce/profiles/weekly_pre_assembly_task.md)" -p claudius'
