logs/
backups/
node_modules/
__pycache__/
*.pyc
.env
secrets.env

# OpenCode observability — captured LLM prompt/response data.
# These contain full prompt and response text and MUST NOT be committed.
var/opencode-observability/

# Agent worktrees created by the Workflow harness. Nested repositories: `git add -A` stages one
# as a 160000 gitlink pointing at a commit that exists only in this clone. bin/auto-sync refuses
# on that property regardless, but a refusal is a stopped sync plus a Buzz alert every 15
# minutes — ignoring the path we KNOW about keeps the guard for the ones we do not.
.claude/worktrees/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# The eval tool writes <plugin>/evals/results/ per run. The runner evaluates a COPY outside
# $HOME so the checkout is never written, but agent-workforce-auto-sync.timer commits any dirty
# tree within 15 minutes, so this is the belt behind that brace.
skills/*/evals/results/
