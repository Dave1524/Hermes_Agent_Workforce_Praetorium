logs/
backups/
node_modules/
__pycache__/
*.pyc
.env
secrets.env

# OpenCode observability — captured LLM prompt/response data.
# These contain full prompt and response text and MUST NOT be committed.
var/opencode-observability/

# Agent worktrees created by the Workflow harness. Nested repositories: `git add -A` stages one
# as a 160000 gitlink pointing at a commit that exists only in this clone. Keep worktree
# state out of explicit commits and PRs.
.claude/worktrees/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# The eval tool writes <plugin>/evals/results/ per run. The runner evaluates a COPY outside
# $HOME so the checkout is never written; keep generated eval results out of manual commits too.
skills/*/evals/results/
