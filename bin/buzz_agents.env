# buzz_agents.env — slug → Nostr pubkey for the agents a delivery may address.
#
#   AGENT_<slug>=<64-hex-pubkey>
#
# A pubkey is public by construction: it is the address every signed event already
# carries, and it authenticates nothing on its own. The signing key and the NIP-OA auth
# tag live only in ~/.config/buzz-agents/<name>.env, behind the deny-list, and are read
# solely by bin/buzz_publish.sh. Nothing that grants authority belongs in this file.
#
# It is separate from buzz_routes.env so that table keeps naming no identity at all:
# routes say where and who-by-slug, this says which key that slug is.
#
# These are the identities minted in Buzz Desktop on 2026-08-03. Replacing an agent's
# identity means updating the value here AND the `filter` line in that agent's
# ~/.config/buzz-team/<name>.toml — a mention naming a pubkey the rules do not admit is
# accepted by the relay and dropped at dispatch.

AGENT_marcus=abbc19ddcc22f6511183936a4993359d4d22c6ef5afc53c7dba65bdeb958916b
AGENT_claudius=818238434309416fa7fd8cc482908e61f8ebcb6978ff974ccf2044d4ed014c7c
AGENT_augustus=d36e4b8b8c8c3c6424c884110c22fcbbed6fc2d55374f4576ee51d43145c7d01
AGENT_trajan=1212e9a7e5a2c41b4e56d266fe2b42bb1e528cfa58a482975b9e5ba4d389fab0
