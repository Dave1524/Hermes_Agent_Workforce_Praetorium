# buzz_routes.env — non-secret route table for bin/deliver.sh.
#
# One line per route key: ROUTE_<key>=<buzz-channel-uuid>. Nothing else belongs here.
# No agent names, no pubkeys, no credentials — the signing identity is loaded only by
# the credential helper under the deny-listed ~/.config/buzz-agents/ tree.
#
# Channel UUIDs are stable across renames; update a value only when the destination
# channel UUID itself changes.
#
# An EMPTY value means "route not configured yet". deliver.sh then skips Buzz, still
# attempts Discord, and records a config_error receipt — it never fails the caller.
# The six channels are created by Dave from Buzz Desktop (owner authority; this box
# holds no owner key), which is Phase 2a of docs/buzz-channel-map.md.

ROUTE_ops=
ROUTE_research=
ROUTE_content=
ROUTE_bd=
ROUTE_signals=
ROUTE_approvals=
