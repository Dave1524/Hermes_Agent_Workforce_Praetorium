#!/usr/bin/env bash
# Auto-sync: small, safe updates on the default branch get committed and pushed quickly.
# Significant development must happen in a worktree or branch.
set -euo pipefail

PRIMARY="main"
# How long the checkout may sit off $PRIMARY before the refusal below alerts. 0 alerts at once.
GRACE_HOURS="${AUTO_SYNC_OFF_MAIN_GRACE_HOURS:-4}"

cd "$(dirname "$0")/.."

# Epoch of the newest HEAD-reflog entry that left $PRIMARY; prints nothing when there is none.
# `checkout: moving from <a> to <b>` is what both `git checkout` and `git switch` write, and <a>
# is the branch HEAD was on at that moment, so the checkout cannot have left $PRIMARY for good
# any earlier: the answer can overstate how long it has been off $PRIMARY, never understate it.
left_primary_at() {
    local reflog selector message
    reflog=$(git reflog --date=unix --format='%gd %gs' HEAD) || return 1
    while read -r selector message; do
        [[ $message == "checkout: moving from $PRIMARY to "* ]] || continue
        selector=${selector#HEAD@\{}
        printf '%s' "${selector%\}}"
        return 0
    done <<< "$reflog"
}

hours_minutes() { printf '%dh%02dm' $(( $1 / 3600 )) $(( $1 % 3600 / 60 )); }

# Only operate on the primary branch. Off it, refusing is right but alerting is not, at first: a
# session that switched this checkout to a feature branch is a fault only once it is forgotten.
# So the run skips quietly for GRACE_HOURS after the checkout left $PRIMARY and alerts after
# that. "Since when" comes from git alone; when git cannot say, the run alerts.
branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "$branch" != "$PRIMARY" ]]; then
    off_primary="auto-sync: not on $PRIMARY (current: $branch)"
    if ! [[ $GRACE_HOURS =~ ^[0-9]+$ ]]; then
        echo "$off_primary, and AUTO_SYNC_OFF_MAIN_GRACE_HOURS='$GRACE_HOURS' is not a whole number of hours. Refusing to sync." >&2
        exit 1
    fi
    # Base 10 forced: bash reads `08` as bad octal, and a failed (( )) test takes the quiet branch.
    GRACE_HOURS=$(( 10#$GRACE_HOURS ))
    now=$(date +%s)
    left_at=$(left_primary_at) || left_at=""
    if ! [[ $left_at =~ ^[0-9]+$ ]] || (( left_at > now )); then
        echo "$off_primary, and the HEAD reflog has no usable 'checkout: moving from $PRIMARY' entry to say since when. Refusing to sync." >&2
        exit 1
    fi
    off_for="for $(hours_minutes $(( now - left_at ))) (since $(date -u -d "@$left_at" '+%Y-%m-%d %H:%M UTC'))"
    if (( now - left_at >= GRACE_HOURS * 3600 )); then
        echo "$off_primary $off_for, past the ${GRACE_HOURS}h grace window. Refusing to sync." >&2
        exit 1
    fi
    echo "$off_primary $off_for, inside the ${GRACE_HOURS}h grace window. Skipping; nothing committed."
    exit 0
fi

# Pull first to avoid trivial conflicts
if ! git pull --ff-only origin "$PRIMARY"; then
    echo "auto-sync: could not fast-forward from origin. Manual resolution required." >&2
    exit 1
fi

# Nothing to commit?
#
# This has to agree with the `git add -A` below, and only `git status --porcelain` does.
# `git diff` / `git diff --cached` see TRACKED paths only, so a tree holding nothing but NEW
# files reported "working tree clean. Nothing to do" here every 15 minutes, indefinitely, while
# add -A would have committed them on the very next line. The cost was a delayed sync with a
# wrong author story: the file waited for some unrelated tracked edit, then got swept in under
# an `Auto-sync:` subject dated days after it was written. (W16, fixed 2026-09-03.)
#
# --porcelain and add -A honour the same exclusions (.gitignore, .git/info/exclude,
# assume-unchanged/skip-worktree), so an ignored file still reads clean and no empty commit is
# attempted. Neither is asked about ignored paths: --porcelain lists them only under --ignored.
#
# Assigned on its own line, NOT inline in the `if`: `set -e` is suspended inside a condition, so
# a command substitution there would swallow a git failure and report a broken repo as clean.
# Out here a non-zero git exits the script loudly, which is the direction this job should fail.
pending=$(git status --porcelain)
if [ -z "$pending" ]; then
    echo "auto-sync: working tree clean. Nothing to do."
    exit 0
fi

timestamp=$(date -u '+%Y-%m-%d %H:%M:%S UTC')
message="Auto-sync: $PRIMARY updates at $timestamp"

git add -A

# A nested repository is staged by `git add -A` as a 160000 GITLINK — an accidental submodule
# with no `.gitmodules`, recording a commit that exists only in this clone. It is the one thing
# this job must never push: it commits and pushes cleanly, exit 0, and a fresh clone gets a
# directory git refuses to populate. The W16 widening above is what made it REACHABLE — under
# the old tracked-only gate an untracked worktree directory never woke the job at all — and this
# box creates nested repos routinely (`git worktree` and the agent harness both do; the source
# checkout held six under .claude/worktrees/ on 2026-09-03).
#
# Ignoring the known paths is not enough on its own. An ignore list is something someone has to
# remember to extend, and the next nested repo lands somewhere nobody predicted; .gitignore
# carries the two paths we know about, this carries the property. Fails CLOSED: non-zero reaches
# OnFailure=agent-alert@%n.service, which is the loud, recoverable direction. The index is reset
# first so the next tick starts from a clean slate rather than re-committing a staged gitlink
# through some other path.
gitlinks=$(git ls-files --stage | awk '$1 == "160000" { sub(/^[^\t]*\t/, ""); print }')
if [ -n "$gitlinks" ] && [ -z "$(git ls-files -- .gitmodules)" ]; then
    git reset -q
    echo "auto-sync: REFUSING to sync — nested repositories staged as gitlinks, with no .gitmodules:" >&2
    printf '%s\n' "$gitlinks" | sed 's/^/  /' >&2
    echo "auto-sync: these are almost certainly git worktrees or a stray clone. Add them to" >&2
    echo "auto-sync: .gitignore (or .git/info/exclude), or remove them; the next tick then syncs" >&2
    echo "auto-sync: normally. Nothing was committed and origin is untouched." >&2
    exit 1
fi

git commit -m "$message"
git push origin "$PRIMARY"

synced_to=$(git rev-parse --short HEAD)
echo "auto-sync: pushed $PRIMARY at $synced_to"
